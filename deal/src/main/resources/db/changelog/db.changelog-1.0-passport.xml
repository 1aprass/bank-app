<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="1" author="Daria">
        <createTable tableName="passport">
            <column name="passport_uuid" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="series" type="varchar(10)" />
            <column name="number" type="varchar(10)" />
            <column name="issue_branch" type="varchar(10)" />
            <column name="issue_date" type="date"/>
        </createTable>
    </changeSet>
</databaseChangeLog>